{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Lumovi",
  "description": "Lumovi is a calm, fast Kubernetes dashboard. Run it on your desktop against every cluster in your kubeconfig, in your cluster for your whole team to sign in to, or as one fleet for many clusters.",
  "variables": {
    "version": "1.12.0"
  },
  "colors": {
    "primary": "#2675d3",
    "light": "#5ea2f0",
    "dark": "#2675d3"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0a0a0a"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark-default"
      }
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://lumovi.dev"
      },
      {
        "type": "github",
        "href": "https://github.com/Lumovi/Lumovi"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://lumovi.dev/#download"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Using Lumovi",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "get-started/desktop",
              "get-started/in-your-cluster",
              "get-started/tour",
              "get-started/sign-in"
            ]
          },
          {
            "group": "Clusters",
            "pages": [
              "clusters/connect",
              "clusters/fleet",
              "clusters/namespaces",
              "clusters/permissions",
              "clusters/your-access"
            ]
          },
          {
            "group": "Explore",
            "pages": [
              "explore/overview",
              "explore/workloads",
              "explore/pods",
              "explore/nodes",
              "explore/networking",
              "explore/config-and-storage",
              "explore/events",
              "explore/details",
              "explore/map",
              "explore/health",
              "explore/finding-things"
            ]
          },
          {
            "group": "Make changes",
            "pages": [
              "changes/safely",
              "changes/actions",
              "changes/yaml",
              "changes/create",
              "changes/bulk",
              "changes/read-only",
              "changes/undo-and-activity"
            ]
          },
          {
            "group": "Debug",
            "pages": [
              "debug/logs",
              "debug/shell",
              "debug/node-shell",
              "debug/port-forwarding",
              "debug/terminal"
            ]
          },
          {
            "group": "Metrics",
            "pages": [
              "metrics/live-usage",
              "metrics/usage-history",
              "metrics/right-sizing"
            ]
          },
          {
            "group": "Helm",
            "pages": [
              "helm/releases",
              "helm/upgrade-and-rollback",
              "helm/install",
              "helm/local-charts"
            ]
          },
          {
            "group": "Custom resources",
            "pages": [
              "custom-resources/overview",
              "custom-resources/add-ons",
              "custom-resources/built-in-views",
              "custom-resources/write-a-view"
            ]
          },
          {
            "group": "AI assistants",
            "pages": [
              "assistants/overview",
              "assistants/server",
              "assistants/permissions",
              "assistants/approvals",
              "assistants/tools"
            ]
          },
          {
            "group": "Audit log",
            "pages": [
              "audit/overview",
              "audit/verify",
              "audit/events"
            ]
          },
          {
            "group": "Desktop app",
            "pages": [
              "desktop/network",
              "desktop/policy"
            ]
          }
        ]
      },
      {
        "tab": "In your cluster",
        "icon": "server",
        "groups": [
          {
            "group": "Run it in your cluster",
            "pages": [
              "server/overview",
              "server/install",
              "server/expose",
              "server/upgrade"
            ]
          },
          {
            "group": "Sign-in",
            "pages": [
              "server/auth/tokens",
              "server/auth/single-sign-on",
              "server/auth/proxy",
              "server/access"
            ]
          },
          {
            "group": "Fleet",
            "pages": [
              "server/fleet",
              "server/fleet/members",
              "server/fleet/discovery",
              "server/fleet/agents",
              "server/fleet/sevalla"
            ]
          },
          {
            "group": "Operate",
            "pages": [
              "server/security",
              "server/hardening",
              "server/network",
              "server/views",
              "server/assistants",
              "server/audit-log",
              "server/docker"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "server/helm-values",
              "server/configuration"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "library",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/keyboard-shortcuts",
              "reference/view-format",
              "reference/environment-variables",
              "reference/resource-kinds",
              "reference/privacy-and-security"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "reference/troubleshooting",
              "reference/faq"
            ]
          },
          {
            "group": "Project",
            "pages": [
              "changelog",
              "reference/build-from-source"
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "search": {
    "prompt": "Search the docs…"
  },
  "seo": {
    "metatags": {
      "og:site_name": "Lumovi Docs",
      "og:image": "https://docs.lumovi.dev/og.png",
      "og:image:alt": "Lumovi documentation: install Lumovi, connect your clusters, and make the most of every view.",
      "twitter:card": "summary_large_image"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Lumovi/Lumovi",
      "website": "https://lumovi.dev"
    },
    "links": [
      {
        "header": "Lumovi",
        "items": [
          { "label": "Website", "href": "https://lumovi.dev" },
          { "label": "Download", "href": "https://lumovi.dev/#download" },
          { "label": "Releases", "href": "https://github.com/Lumovi/Lumovi/releases" }
        ]
      },
      {
        "header": "Project",
        "items": [
          { "label": "GitHub", "href": "https://github.com/Lumovi/Lumovi" },
          { "label": "Contributing", "href": "https://github.com/Lumovi/Lumovi/blob/main/CONTRIBUTING.md" },
          { "label": "Security", "href": "https://github.com/Lumovi/Lumovi/blob/main/SECURITY.md" },
          { "label": "Sponsor", "href": "https://github.com/sponsors/kotapeter" }
        ]
      }
    ]
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Nothing here",
      "description": "This page doesn't exist, or it moved. Try the search, or start from the [introduction](/)."
    }
  }
}
